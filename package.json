{
  "name": "piprogram",
  "version": "0.1.0",
  "private": true,
  "description": "Content for distribution: hymns, slides, PPTX, Canva integration and the stage page.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/pipgm-service.js",
  "types": "dist/pipgm-service.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/main.js",
    "cli": "node dist/cli-main.js",
    "generate": "openapi --input openapi/openapi.yaml --output src/generated --client fetch && node scripts/fix-generated-imports.mjs",
    "prebuild": "npm run generate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fastify": "^5.2.0"
  },
  "bin": {
    "piprogram": "dist/cli-main.js"
  }
}
